# ==========================================
# GarbaFits - Comprehensive .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
out/

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Temporary Cache
.cache/
.turbo/
.npm/


